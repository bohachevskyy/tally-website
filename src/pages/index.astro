---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import { faqs } from '../data/faqs';
import { SITE_URL, APP_STORE_URL } from '../config';

import usageShot from '../assets/screens/usage.png';
import limitsShot from '../assets/screens/limits.png';
import detailShot from '../assets/screens/limit-detail.png';
import statsShot from '../assets/screens/stats.png';

const title = 'Tally: free screen time limits for iPhone that keep count';
const description =
  'Tally is a free iPhone app that sets daily app limits, shows how much time you really spend in each app, and counts every time you break your own rules. No ads, no subscription, no account. Your data stays on your phone.';

const phoneSizes = '(max-width: 860px) 76vw, 300px';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Tally',
    alternateName: 'Tally — Screen Time Limits',
    url: SITE_URL,
    description,
    operatingSystem: 'iOS 17.0 or later',
    applicationCategory: 'LifestyleApplication',
    image: `${SITE_URL}/icon-512.png`,
    screenshot: `${SITE_URL}/og.png`,
    ...(APP_STORE_URL ? { installUrl: APP_STORE_URL, downloadUrl: APP_STORE_URL } : {}),
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    featureList: [
      'Daily time limits per app or group of apps',
      'Different limits for each day of the week',
      'Live per-app usage with 7, 14 and 30-day charts',
      'Overrides that grant a set number of extra minutes',
      'Calendar of days you exceeded each limit',
      'On-device only: no account, no analytics, no ads',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Nav />

  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="free-pill"><span>100% free</span> No ads · No subscription · No account</p>
          <h1>Tally every slip.</h1>
          <p class="lede">
            Lots of apps block your screen time. Tally also measures it. You
            get real usage numbers, extra time that comes in counted minutes,
            and a running tally of every time you broke your own rules.
          </p>
          <div class="cta-row">
            <AppStoreButton />
            <a class="btn ghost" href="#features">See how it works</a>
          </div>
          <p class="hero-note">Free for iPhone · iOS 17+ · Your data stays on your phone</p>
        </div>
        <div class="hero-shot" aria-hidden="false">
          <div class="phone back">
            <Image src={statsShot} alt="" widths={[300, 600]} sizes="260px" format="webp" loading="eager" />
          </div>
          <div class="phone front">
            <Image
              src={usageShot}
              alt="Tally's Usage screen with a seven-day usage chart and daily limits for each app"
              widths={[320, 640]}
              sizes="(max-width: 860px) 70vw, 300px"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="pillars" aria-label="Why Tally">
      <div class="wrap pillar-grid">
        <div class="pillar">
          <div class="pillar-icon indigo">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 19V12M10 19V5M16 19V9M22 19H2"/>
            </svg>
          </div>
          <h2 class="h3">Real usage numbers</h2>
          <p>
            Usage for each app, for each day, measured on your iPhone and
            shown next to the limit you set.
          </p>
        </div>
        <div class="pillar">
          <div class="pillar-icon teal">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2h5"/>
            </svg>
          </div>
          <h2 class="h3">Extra time is counted</h2>
          <p>
            Need more time? The rule stays on. You give yourself a set number
            of extra minutes, and the clock keeps running.
          </p>
        </div>
        <div class="pillar">
          <div class="pillar-icon red">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 4.5v15M9.5 4.5v15M14 4.5v15M18.5 4.5v15M2.5 17L21.5 7"/>
            </svg>
          </div>
          <h2 class="h3">Every slip on record</h2>
          <p>
            Tally remembers how often you broke each rule, on which days,
            and by how much. Keeping score keeps you honest.
          </p>
        </div>
      </div>
    </section>

    <!-- Feature: tracking -->
    <section class="feature" id="features">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow indigo-text">Tracking</p>
          <h2>A number, not a feeling</h2>
          <p>
            Most screen-time reports are vague enough to ignore. Tally shows
            the actual figure: how long you've used each app today, updated
            live, with your recent history right below it. It's hard to argue
            with a number you can see.
          </p>
          <ul>
            <li>A live "used today" count for every app</li>
            <li>7, 14, or 30-day charts across all your limits</li>
            <li>Each rule gets its own color, so trends stand out</li>
          </ul>
        </div>
        <div class="feature-shot">
          <div class="phone">
            <Image src={usageShot} alt="Usage screen with a colored seven-day chart and a list of app rules" widths={[300, 600]} sizes={phoneSizes} format="webp" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature: limits -->
    <section class="feature flip">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow teal-text">Limits</p>
          <h2>Give every app a number</h2>
          <p>
            A limit in Tally is an exact daily budget: five minutes for
            TikTok, twenty for Twitter, three hours for Telegram. Set it once and Tally
            counts against it every day. When the time is up, the app gets
            blocked.
          </p>
          <ul>
            <li>Limit one app or a whole group with a shared budget</li>
            <li>Set a different limit for each day of the week</li>
            <li>Set a day to zero and the app stays blocked all day</li>
            <li>Limits reset at midnight, so there's nothing to maintain</li>
          </ul>
        </div>
        <div class="feature-shot">
          <div class="phone">
            <Image src={limitsShot} alt="Rules screen listing six app limits with their daily budgets" widths={[300, 600]} sizes={phoneSizes} format="webp" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature: overrides -->
    <section class="feature">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow red-text">Overrides</p>
          <h2>Need more? Take five minutes.</h2>
          <p>
            The weak spot in most screen-time tools is the escape hatch. One
            tap on "ignore limit" and the rule is gone for the day. Tally
            doesn't have an off switch. From the block screen you add a set
            number of minutes, and the clock keeps running.
          </p>
          <p>
            Every override gets counted: how many times, on which apps, and
            for how long.
          </p>
        </div>
        <div class="feature-shot">
          <div class="phone">
            <Image src={detailShot} alt="TikTok rule showing a 5-minute daily limit and the last seven days of usage" widths={[300, 600]} sizes={phoneSizes} format="webp" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Feature: stats -->
    <section class="feature flip">
      <div class="wrap feature-grid">
        <div class="feature-copy">
          <p class="eyebrow indigo-text">The record</p>
          <h2>How often do you break your own rules?</h2>
          <p>
            Tally gives you the exact answer, like "Exceeded 9 of 12 days,
            2h 25m over limit." Every broken rule shows up on a calendar for
            that app, with the days, the count, and how far over you went.
            The point isn't guilt. It's that a number you can see is a number
            you can change.
          </p>
          <ul>
            <li>A calendar of days over and under each limit</li>
            <li>How many overrides, and the total time over your limits</li>
            <li>Week, month, and year views to spot patterns</li>
          </ul>
        </div>
        <div class="feature-shot">
          <div class="phone">
            <Image src={statsShot} alt="Stats screen with a monthly calendar marking the days the Instagram limit was exceeded" widths={[300, 600]} sizes={phoneSizes} format="webp" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Free -->
    <section class="free" aria-labelledby="free-title">
      <div class="wrap">
        <div class="free-card">
          <div class="free-head">
            <p class="price"><span class="cur">$</span>0</p>
            <div>
              <h2 id="free-title">Free. Not a free trial.</h2>
              <p>Every feature comes with the download, and you'll never be asked for money.</p>
            </div>
          </div>
          <ul class="free-list">
            <li>No subscription</li>
            <li>No in-app purchases</li>
            <li>No ads</li>
            <li>No account or sign-up</li>
            <li>Unlimited rules</li>
            <li>Full history and stats</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Privacy -->
    <section class="privacy" id="privacy">
      <div class="wrap privacy-inner">
        <div class="pillar-icon teal lock" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
          </svg>
        </div>
        <h2>Your usage data stays on your iPhone.</h2>
        <p>
          Tally is built on Apple's Screen Time framework, so your app
          activity is processed entirely on your iPhone. There's no account to
          create, no server collecting your data, and no analytics. You don't
          pay with money, and you don't pay with your data either.
          <a href="/privacy/">Read the privacy policy →</a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq">
      <div class="wrap faq-inner">
        <h2>Questions</h2>
        <div class="faqs">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
        <p class="faq-more">
          Still stuck? <a href="/support/">Get support →</a>
        </p>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="final" id="download">
      <div class="wrap final-inner">
        <h2>Your rules, your numbers.<br />Tally keeps count.</h2>
        <AppStoreButton />
        <p class="hero-note">Free for iPhone · iOS 17+ · No account needed</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding: 88px 0 56px;
    overflow: hidden;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 720px;
    height: 720px;
    background: radial-gradient(closest-side, rgba(97, 107, 211, 0.28), transparent);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 48px;
    position: relative;
  }

  .free-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--text-dim);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: 999px;
    padding: 5px 14px 5px 5px;
    margin-bottom: 26px;
  }

  .free-pill span {
    background: var(--teal);
    color: #04201c;
    font-weight: 700;
    font-size: 13px;
    border-radius: 999px;
    padding: 2px 10px;
    white-space: nowrap;
  }

  h1 {
    font-size: clamp(44px, 7vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .lede {
    margin-top: 24px;
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 32em;
  }

  .cta-row {
    display: flex;
    gap: 14px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .hero-note {
    margin-top: 18px;
    font-size: 14px;
    color: var(--text-faint);
  }

  .hero-shot {
    position: relative;
    display: flex;
    justify-content: center;
    min-height: 560px;
  }

  .hero-shot .front {
    width: min(300px, 70vw);
    position: relative;
    z-index: 2;
    transform: translateX(-36px);
  }

  .hero-shot .back {
    position: absolute;
    width: 260px;
    top: 48px;
    right: -8px;
    transform: rotate(6deg);
    opacity: 0.55;
    z-index: 1;
  }

  /* ---- Phone frame ---- */
  .phone {
    width: min(300px, 76vw);
    border-radius: 44px;
    padding: 10px;
    background: #1a1a1f;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 40px 80px -24px rgba(0, 0, 0, 0.7),
      0 0 120px -40px rgba(124, 124, 240, 0.35);
  }

  .phone img {
    border-radius: 34px;
    width: 100%;
    height: auto;
  }

  /* ---- Pillars ---- */
  .pillars {
    padding: 80px 0;
    border-top: 1px solid var(--border);
  }

  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .pillar-icon svg {
    width: 22px;
    height: 22px;
  }

  .pillar-icon.indigo { background: rgba(124, 124, 240, 0.15); color: var(--indigo); }
  .pillar-icon.teal { background: rgba(62, 184, 169, 0.15); color: var(--teal); }
  .pillar-icon.red { background: rgba(240, 85, 74, 0.14); color: var(--red); }

  .h3 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .pillar p {
    color: var(--text-dim);
    font-size: 16px;
  }

  /* ---- Features ---- */
  .feature {
    padding: 72px 0;
    border-top: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .flip .feature-copy { order: 2; }
  .flip .feature-shot { order: 1; }

  .feature-shot {
    display: flex;
    justify-content: center;
  }

  .feature-shot .phone {
    box-shadow: 0 32px 64px -24px rgba(0, 0, 0, 0.7);
  }

  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 14px;
  }

  .indigo-text { color: var(--indigo); }
  .teal-text { color: var(--teal); }
  .red-text { color: var(--red); }

  h2 {
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 750;
    text-wrap: balance;
  }

  .feature-copy > p {
    margin-top: 18px;
    color: var(--text-dim);
  }

  .feature-copy ul {
    margin-top: 22px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-copy li,
  .free-list li {
    color: var(--text-dim);
    padding-left: 28px;
    position: relative;
  }

  .feature-copy li::before,
  .free-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 14px;
    height: 8px;
    border-left: 2px solid var(--teal);
    border-bottom: 2px solid var(--teal);
    transform: rotate(-45deg) scale(0.8);
  }

  /* ---- Free ---- */
  .free {
    padding: 88px 0;
    border-top: 1px solid var(--border);
  }

  .free-card {
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: 44px;
    background:
      radial-gradient(600px 240px at 0% 0%, rgba(62, 184, 169, 0.12), transparent),
      var(--bg-raised);
  }

  .free-head {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .free-head p:not(.price) {
    color: var(--text-dim);
    margin-top: 8px;
    font-size: 18px;
  }

  .price {
    font-size: 96px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--teal);
    flex: none;
  }

  .price .cur {
    font-size: 44px;
    vertical-align: 0.9em;
    margin-right: 2px;
  }

  .free-list {
    list-style: none;
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px 24px;
  }

  .free-list li {
    color: var(--text);
  }

  /* ---- Privacy ---- */
  .privacy {
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .privacy-inner {
    max-width: 720px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .privacy p {
    margin-top: 20px;
    color: var(--text-dim);
    font-size: 18px;
  }

  .privacy a,
  .faq-more a {
    color: var(--indigo);
  }

  .privacy a:hover,
  .faq-more a:hover {
    text-decoration: underline;
  }

  /* ---- FAQ ---- */
  .faq {
    padding: 88px 0;
    border-top: 1px solid var(--border);
  }

  .faq-inner {
    max-width: 760px;
  }

  .faqs {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  details {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 22px;
  }

  summary {
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 28px;
  }

  summary::-webkit-details-marker { display: none; }

  summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-faint);
    font-size: 20px;
    font-weight: 400;
  }

  details[open] summary::after { content: '–'; }

  details p {
    margin-top: 12px;
    color: var(--text-dim);
  }

  .faq-more {
    margin-top: 24px;
    color: var(--text-dim);
  }

  /* ---- Final CTA ---- */
  .final {
    padding: 112px 0 128px;
    border-top: 1px solid var(--border);
  }

  .final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 32px;
  }

  .final h2 {
    font-size: clamp(32px, 5vw, 52px);
  }

  .final .hero-note {
    margin-top: -12px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .hero { padding-top: 56px; }

    .hero-grid,
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-shot { min-height: 0; }
    .hero-shot .front { transform: none; }
    .hero-shot .back { display: none; }

    .flip .feature-copy { order: 1; }
    .flip .feature-shot { order: 2; }

    .pillar-grid { grid-template-columns: 1fr; }

    .free-card { padding: 32px 24px; }
    .free-head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .free-list { grid-template-columns: 1fr 1fr; }

    .privacy-inner { text-align: left; align-items: flex-start; }
  }

  @media (max-width: 480px) {
    .free-list { grid-template-columns: 1fr; }
    .cta-row :global(.btn) { width: 100%; justify-content: center; }
    .free-pill { font-size: 13px; }
  }
</style>
