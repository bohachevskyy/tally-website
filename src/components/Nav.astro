---
const APP_STORE_URL = '#download';
---
<header>
  <nav class="wrap">
    <a class="logo" href="/">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect x="14" y="30" width="8" height="18" rx="3" fill="#7c7cf0"/>
        <rect x="28" y="20" width="8" height="28" rx="3" fill="#7c7cf0"/>
        <rect x="42" y="26" width="8" height="22" rx="3" fill="#3eb8a9"/>
      </svg>
      Tally
    </a>
    <a class="btn ghost small" href={APP_STORE_URL}>Download</a>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(9, 9, 11, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo svg {
    width: 26px;
    height: 26px;
  }

  .small {
    padding: 8px 18px;
    font-size: 14px;
  }
</style>
