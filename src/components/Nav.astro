---
import Logo from './Logo.astro';
---
<header>
  <nav class="wrap" aria-label="Main">
    <a class="logo" href="/" aria-label="Tally home">
      <Logo size={28} />
      Tally
    </a>
    <div class="links">
      <a href="/#features">Features</a>
      <a href="/#privacy">Privacy</a>
      <a href="/#faq">FAQ</a>
      <a class="btn ghost small" href="/#download">Get Tally — free</a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(9, 9, 11, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    color: var(--text-dim);
  }

  .links > a:not(.btn):hover {
    color: var(--text);
  }

  .small {
    padding: 8px 18px;
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .links > a:not(.btn) {
      display: none;
    }
  }
</style>
