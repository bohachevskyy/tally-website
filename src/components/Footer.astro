---
import { CONTACT_EMAIL } from '../config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap inner">
    <div class="brand">
      <span class="name"><Logo size={20} /> Tally</span>
      <span class="tag">Free screen-time limits that keep count.</span>
    </div>
    <nav aria-label="Footer">
      <a href="/privacy/">Privacy</a>
      <a href="/support/">Support</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
    </nav>
  </div>
  <div class="wrap legal">
    © {year} Tally. Free, private, and made for people who want their time back.
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 48px 0 40px;
  }

  .inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 17px;
  }

  .tag {
    color: var(--text-faint);
    font-size: 14px;
  }

  nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
    color: var(--text-dim);
  }

  nav a:hover {
    color: var(--text);
  }

  .legal {
    margin-top: 36px;
    color: var(--text-faint);
    font-size: 13px;
  }
</style>
